# Copy to .env and fill in.
SECRET_KEY_BASE=          # bin/rails secret  (keep it: it also encrypts authenticator secrets)
APP_HOST=logbook.example.com
FORCE_SSL=true            # false if you serve plain http on a LAN
ASSUME_SSL=true           # behind a TLS-terminating proxy
# Optional email for invitations and password resets:
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=AMT Logbook <logbook@example.com>
