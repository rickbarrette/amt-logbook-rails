<% content_for :title, "Import entries" %>
<h1 class="h1 mb-1">Import entries</h1>
<p class="mb-4 max-w-3xl text-sm muted">Bring in experience you logged somewhere else. Every entry comes in as a <strong>draft</strong>: check it, then <%= Setting.ink_signatures? ? "record it" : "send it to your supervisor to sign" %>. Nothing counts toward your 14 CFR 65.77 totals until then. Entries already in your logbook (same day, hours and description) are skipped, so importing a file twice is safe.</p>

<div class="grid gap-6 lg:grid-cols-2">
  <div class="card">
    <h2 class="h2 mb-3">Upload a file</h2>
    <%= form_with url: imports_path, multipart: true, class: "space-y-4", data: { turbo: false } do |f| %>
      <div>
        <%= f.file_field :file, accept: ".csv,.txt,.json,text/csv,application/json", required: true, class: "block w-full text-sm file:mr-3 file:rounded-lg file:border-0 file:bg-slate-100 file:px-3 file:py-2 file:text-sm dark:file:bg-slate-700" %>
        <p class="hint">Up to <%= EntryImport::MAX_BYTES / 1.megabyte %> MB and <%= number_with_delimiter(EntryCsv::MAX_ROWS) %> rows.</p>
      </div>
      <%= f.submit "Upload and preview", class: "btn-primary" %>
    <% end %>
  </div>
  <div class="card space-y-3 text-sm">
    <div>
      <h3 class="font-semibold">A spreadsheet (CSV)</h3>
      <p class="muted">From Excel, Google Sheets, Numbers or another logbook app: save or download it as <strong>CSV</strong>. It needs a header row and, at least, a date, hours and a description for each entry. You'll match the columns next. A missing category or ATA chapter is suggested from the description.</p>
    </div>
    <div>
      <h3 class="font-semibold">An AMT Logbook export (JSON)</h3>
      <p class="muted">The full export from <%= link_to "Print & export", logbook_path, class: "link" %> on this or another AMT Logbook server. Electronic signatures can't move between servers (each server seals its own), so signed entries come in as drafts that show who signed them originally.</p>
    </div>
  </div>
</div>

<% if @imports.any? %>
  <h2 class="h2 mb-2 mt-8">Recent imports</h2>
  <div class="card overflow-x-auto">
    <table class="table">
      <thead><tr><th>File</th><th>Uploaded</th><th>Status</th><th class="text-right">Imported</th><th class="text-right">Skipped</th></tr></thead>
      <tbody>
        <% @imports.each do |i| %>
          <tr>
            <td><%= link_to i.filename.presence || "Import ##{i.id}", import_path(i), class: "link" %></td>
            <td><%= l(i.created_at, format: :short) %></td>
            <td><%= i.done? ? "Imported" : "Waiting for you" %></td>
            <td class="text-right"><%= i.created_count if i.done? %></td>
            <td class="text-right"><%= i.skipped_count if i.done? %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
