<%= form_with url: timers_path, class: "grid gap-3 sm:grid-cols-2 lg:grid-cols-[9rem_11rem_minmax(0,1fr)_auto]", data: { controller: "aircraft-lookup", aircraft_lookup_url_value: lookup_aircraft_index_path } do |f| %>
  <div>
    <%= f.label :n_number, "N-number", class: "label" %>
    <%= f.text_field :n_number, placeholder: "N12345", autocapitalize: "characters", class: "input uppercase", data: { aircraft_lookup_target: "input", action: "input->aircraft-lookup#lookup" } %>
    <p class="hint" data-aircraft-lookup-target="result"></p>
  </div>
  <div><%= f.label :category, class: "label" %><%= f.select :category, category_options, { include_blank: "—" }, class: "input" %></div>
  <div class="sm:col-span-2 lg:col-span-1"><%= f.label :description, "What are you working on?", class: "label" %><%= f.text_field :description, maxlength: 500, class: "input", placeholder: "Optional: you can fill in the entry while the clock runs" %></div>
  <div class="sm:col-span-2 lg:col-span-1">
    <span class="label invisible hidden lg:block" aria-hidden="true">&nbsp;</span>
    <div class="flex gap-2">
      <%= f.submit "Clock in", class: "btn-primary h-10 flex-1 lg:flex-none" %>
      <%= f.button "Clock in & fill in", name: "fill_in", value: "1", class: "btn h-10 flex-1 whitespace-nowrap lg:flex-none", title: "Clock in and open the entry to write it up while you work" %>
    </div>
  </div>
<% end %>
