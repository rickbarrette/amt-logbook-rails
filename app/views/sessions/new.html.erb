<% content_for :title, "Sign in" %>
<div class="mx-auto mt-10 max-w-sm">
  <div class="mb-6 flex items-center gap-3"><img src="/icon.svg" class="h-10 w-10" alt=""><h1 class="h1">AMT Logbook</h1></div>
  <div class="card">
    <% if Sso.enabled? %>
      <%= button_to "Sign in with #{Sso.label}", "/auth/oidc", class: "btn-primary w-full", data: { turbo: false } %>
      <% if Sso.password_login? %><p class="my-4 text-center text-xs muted">or with your email and password</p><% end %>
    <% end %>
    <% if Sso.password_login? %>
    <%= render "passkeys/sign_in", conditional: true, primary: !Sso.enabled? %>
    <p class="my-4 text-center text-xs muted">or with your email and password</p>
    <%= form_with url: session_path, class: "space-y-4" do |f| %>
      <div><%= f.label :email_address, "Email", class: "label" %><%= f.email_field :email_address, required: true, autofocus: true, autocomplete: "username webauthn", value: params[:email_address], class: "input" %></div>
      <div><%= f.label :password, class: "label" %><%= f.password_field :password, required: true, autocomplete: "current-password", maxlength: 72, class: "input" %></div>
      <%= f.submit "Sign in", class: "btn w-full" %>
    <% end %>
    <p class="mt-4 text-center text-sm"><%= link_to "Forgot password?", new_password_path, class: "link" %></p>
    <% end %>
  </div>
  <p class="mt-4 text-center text-xs muted">Accounts are created by invitation from your administrator.</p>
</div>
