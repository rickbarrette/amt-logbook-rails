<%# "Sign in with a passkey"; conditional: also offer passkeys in the email field's autofill. %>
<div data-controller="passkey" data-passkey-mode-value="signin" data-passkey-conditional-value="<%= local_assigns[:conditional] ? "true" : "false" %>"
     data-passkey-options-url-value="<%= options_passkey_session_path %>" data-passkey-url-value="<%= passkey_session_path %>" class="space-y-2">
  <button type="button" class="<%= local_assigns[:primary] ? "btn-primary" : "btn" %> w-full" data-passkey-target="button" data-action="passkey#start">Sign in with a passkey</button>
  <p class="text-sm text-red-700 dark:text-red-300" data-passkey-target="error" hidden></p>
</div>
