<% content_for :title, @aircraft.n_number %>
<h1 class="h1 mb-1"><%= @aircraft.n_number %></h1>
<div class="mb-4 flex flex-wrap items-center gap-3">
  <p class="muted"><%= @aircraft.description.presence || "No details" %> · <%= @aircraft.source == "registry" ? "from the FAA registry" : "entered by hand" %></p>
  <% if RegistryRecord.exists? && aircraft_editor? %><%= button_to "Update from FAA registry", refresh_aircraft_path(@aircraft), class: "btn btn-sm", form: { data: { turbo_confirm: @aircraft.source == "manual" && @aircraft.manufacturer.present? ? "Replace the details typed by hand with the registry's?" : nil } } %><% end %>
</div>
<div class="grid gap-4 lg:grid-cols-3">
  <div class="card">
    <% if aircraft_editor? %>
      <%= form_with model: @aircraft, url: aircraft_path(@aircraft), class: "space-y-3" do |f| %>
        <% %i[manufacturer model year_manufactured serial_number aircraft_type engine_manufacturer engine_model].each do |attr| %>
          <div><%= f.label attr, class: "label" %><%= f.text_field attr, class: "input" %></div>
        <% end %>
        <%= f.submit "Save", class: "btn" %>
      <% end %>
    <% else %>
      <dl class="space-y-2 text-sm">
        <% %i[manufacturer model year_manufactured serial_number aircraft_type engine_manufacturer engine_model].each do |attr| %>
          <div><dt class="muted"><%= Aircraft.human_attribute_name(attr) %></dt><dd><%= @aircraft.public_send(attr).presence || "—" %></dd></div>
        <% end %>
      </dl>
    <% end %>
  </div>
  <div class="card lg:col-span-2 overflow-x-auto"><h2 class="h2 mb-2">Your work on this aircraft</h2><%= render "work_entries/table", entries: @entries %></div>
</div>
