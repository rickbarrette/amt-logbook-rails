<% content_for :title, @aircraft.n_number %>
<h1 class="h1 mb-1"><%= @aircraft.n_number %></h1>
<p class="mb-4 muted"><%= @aircraft.description.presence || "No details" %> · <%= @aircraft.source == "registry" ? "from the FAA registry" : "entered by hand" %></p>
<div class="grid gap-4 lg:grid-cols-3">
  <div class="card">
    <%= form_with model: @aircraft, url: aircraft_path(@aircraft), class: "space-y-3" do |f| %>
      <% %i[manufacturer model year_manufactured serial_number aircraft_type engine_manufacturer engine_model].each do |attr| %>
        <div><%= f.label attr, class: "label" %><%= f.text_field attr, class: "input" %></div>
      <% end %>
      <%= f.submit "Save", class: "btn" %>
    <% end %>
  </div>
  <div class="card lg:col-span-2 overflow-x-auto"><h2 class="h2 mb-2">Your work on this aircraft</h2><%= render "work_entries/table", entries: @entries %></div>
</div>
