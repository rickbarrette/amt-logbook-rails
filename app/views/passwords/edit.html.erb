<% content_for :title, "New password" %>
<div class="mx-auto mt-10 max-w-sm">
  <h1 class="h1 mb-4">Choose a new password</h1>
  <div class="card">
    <%= form_with url: password_path(params[:token]), method: :put, class: "space-y-4" do |f| %>
      <div><%= f.label :password, "New password", class: "label" %><%= f.password_field :password, required: true, autocomplete: "new-password", minlength: User::PASSWORD_MIN, maxlength: 72, class: "input" %>
        <p class="hint">At least <%= User::PASSWORD_MIN %> characters.</p></div>
      <div><%= f.label :password_confirmation, "Repeat it", class: "label" %><%= f.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72, class: "input" %></div>
      <%= f.submit "Save new password", class: "btn-primary w-full" %>
    <% end %>
  </div>
</div>
