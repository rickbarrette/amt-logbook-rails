<% content_for :title, "Backup" %>
<%= render "admin/nav" %>
<h1 class="h1 mb-1">Backup</h1>
<p class="mb-4 max-w-3xl text-sm muted">Download a copy of this server's whole database: every account, logbook entry, signature and setting (<%= @counts.map { |k, v| "#{number_with_delimiter(v)} #{k.downcase}" }.to_sentence %>). It's a single SQLite file, safe to take while the app is running. Keep it somewhere private: it contains everyone's records and password hashes.</p>
<div class="grid gap-6 lg:grid-cols-2">
  <div class="card">
    <%= form_with url: admin_backup_path, class: "space-y-4", data: { turbo: false } do |f| %>
      <label class="flex items-start gap-2 text-sm">
        <%= check_box_tag :include_reference, "1", false, class: "mt-1 accent-sky-700" %>
        <span>Include reference data (<%= @reference.map { |k, v| "#{number_with_delimiter(v)} #{k.downcase}" }.to_sentence %>). It makes the file much bigger and can be downloaded again any time, so it's usually left out.</span>
      </label>
      <% if @sso_confirmed %>
        <p class="text-sm text-emerald-700 dark:text-emerald-400">✓ Confirmed with <%= Sso.label %>.</p>
      <% else %>
        <div class="grid gap-3 sm:grid-cols-2">
          <div><%= label_tag :password, "Your password", class: "label" %><%= password_field_tag :password, nil, required: true, autocomplete: "current-password", class: "input" %></div>
          <div><%= label_tag :code, "Authenticator code", class: "label" %><%= text_field_tag :code, nil, required: true, autocomplete: "one-time-code", inputmode: "numeric", class: "input" %></div>
        </div>
      <% end %>
      <%= f.submit "Download backup", class: "btn-primary" %>
    <% end %>
    <% if Sso.enabled? && current_user.sso_linked? && !@sso_confirmed %>
      <div class="mt-3 flex flex-wrap items-center gap-2 text-sm">
        <span class="muted">Or confirm with <%= Sso.label %>:</span>
        <%= button_to "Confirm with #{Sso.label}", "/auth/oidc", params: { prompt: "login" }, class: "btn btn-sm", data: { turbo: false } %>
      </div>
    <% end %>
  </div>
  <div class="card space-y-2 text-sm">
    <h2 class="h2">Restoring</h2>
    <ol class="list-decimal space-y-1 pl-5">
      <li>Stop the app (in Portainer, stop the stack).</li>
      <li>Replace <code>storage/production.sqlite3</code> in the app's storage volume with the backup file, renamed to that name.</li>
      <li>Start the app. Everyone signs in again.</li>
    </ol>
    <p class="muted">Use the same <code>SECRET_KEY_BASE</code> as when the backup was made: it unlocks authenticator secrets and verifies e-signature seals. Without it, people set up two-factor sign-in again and old signatures show as unverifiable. If you left reference data out, re-import the FAA registry and update airports afterwards.</p>
    <p class="muted">For a single technician's records, use their full export (Print & export) instead.</p>
  </div>
</div>
