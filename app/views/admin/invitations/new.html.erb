<% content_for :title, "Invite" %>
<%= render "admin/nav" %>
<h1 class="h1 mb-4">Invite someone</h1>
<div class="card max-w-lg">
  <%= form_with model: [:admin, @invitation], class: "space-y-4" do |f| %>
    <div><%= f.label :name, class: "label" %><%= f.text_field :name, required: true, class: "input" %><%= field_errors(@invitation, :name) %></div>
    <div><%= f.label :email_address, "Email", class: "label" %><%= f.email_field :email_address, required: true, class: "input" %><%= field_errors(@invitation, :email_address) %></div>
    <div class="flex flex-wrap gap-4 text-sm">
      <label class="flex items-center gap-2"><%= f.check_box :technician, class: "accent-sky-700" %> Technician</label>
      <label class="flex items-center gap-2"><%= f.check_box :supervisor, class: "accent-sky-700" %> Supervisor</label>
      <label class="flex items-center gap-2"><%= f.check_box :admin, class: "accent-sky-700" %> Admin</label>
    </div>
    <p class="hint">Supervisors and admins must set up an authenticator app when they first sign in.</p>
    <%= f.submit "Create invitation", class: "btn-primary" %>
  <% end %>
</div>
