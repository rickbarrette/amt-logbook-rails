<% content_for :title, "Entry" %>
<% e = @entry %>
<div class="mb-4 flex flex-wrap items-center gap-3">
  <h1 class="h1"><%= l(e.performed_on, format: :long) %></h1> <%= status_badge(e.status) %>
  <div class="ml-auto flex gap-2">
    <% if e.user == current_user && e.editable? %>
      <%= link_to "Edit", edit_work_entry_path(e), class: "btn" %>
      <% if e.supervisor %><%= button_to "Send to #{e.supervisor.name}", submit_work_entry_path(e), class: "btn-primary" %><% end %>
      <%= button_to "Delete", work_entry_path(e), method: :delete, class: "btn-danger", form: { data: { turbo_confirm: "Delete this entry?" } } %>
    <% end %>
  </div>
</div>
<% if e.returned? %><div class="mb-4 rounded-lg bg-red-50 px-4 py-3 text-sm text-red-800 dark:bg-red-900/40 dark:text-red-200"><strong>Returned:</strong> <%= e.returned_reason %></div><% end %>

<div class="grid gap-4 md:grid-cols-3">
  <div class="card md:col-span-2 space-y-4">
    <p class="whitespace-pre-line"><%= e.description %></p>
    <dl class="grid grid-cols-2 gap-3 text-sm sm:grid-cols-3">
      <div><dt class="muted">Technician</dt><dd><%= e.user.name %></dd></div>
      <div><dt class="muted">Hours</dt><dd><%= hours(e.hours) %></dd></div>
      <div><dt class="muted">Category</dt><dd><%= e.category_label %></dd></div>
      <div><dt class="muted">Aircraft</dt><dd><%= e.aircraft ? link_to(e.aircraft.to_s, e.aircraft, class: "link") : "—" %></dd></div>
      <div><dt class="muted">ATA</dt><dd><%= e.ata_label || "—" %></dd></div>
      <div><dt class="muted">Reference</dt><dd><%= e.reference.presence || "—" %></dd></div>
      <div><dt class="muted">Location</dt><dd><%= e.location.presence || "—" %></dd></div>
      <% if e.started_at %><div><dt class="muted">Clocked</dt><dd><%= l(e.started_at, format: :short) %> – <%= l(e.ended_at, format: :short) if e.ended_at %></dd></div><% end %>
    </dl>
    <% if e.subject_areas.any? %>
      <div><div class="mb-1 text-sm muted">ACS subject areas</div>
        <div class="flex flex-wrap gap-1"><% e.subject_area_labels.each do |l| %><span class="badge bg-slate-100 text-slate-700 dark:bg-slate-700 dark:text-slate-200"><%= l %></span><% end %></div></div>
    <% end %>
  </div>
  <div class="card">
    <h2 class="h2 mb-2">Signature</h2>
    <% if (s = e.signature) %>
      <p class="font-medium"><%= s.signer_name %></p>
      <p class="text-sm muted"><%= s.certificate_label %> · <%= l(s.signed_at, format: :long) %></p>
      <p class="mt-2 text-sm italic">“<%= s.statement %>”</p>
      <p class="mt-3 text-sm <%= s.intact? ? "text-emerald-700 dark:text-emerald-400" : "text-red-700 dark:text-red-400" %>">
        <%= s.intact? ? "✓ Verified: the entry and signature are unchanged since signing." : "⚠ This entry or its signature changed after signing." %>
      </p>
      <p class="mt-1 font-mono text-xs muted">ID <%= s.seal.first(8) %> · signed with password + authenticator</p>
    <% elsif e.submitted? %>
      <p class="text-sm">Waiting for <strong><%= e.supervisor.name %></strong> to sign (sent <%= l(e.submitted_at, format: :short) %>).</p>
    <% else %>
      <p class="text-sm muted">Not signed yet.<%= " Supervisor: #{e.supervisor.name}." if e.supervisor %></p>
    <% end %>
  </div>
</div>
