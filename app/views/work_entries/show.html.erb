<% content_for :title, "Entry" %>
<% e = @entry %>
<div class="mb-4 flex flex-wrap items-center gap-3">
  <h1 class="h1"><%= l(e.performed_on, format: :long) %></h1> <%= status_badge(e.status) %>
  <div class="ml-auto flex gap-2">
    <% if e.user == current_user && e.editable? %>
      <%= link_to "Edit", edit_work_entry_path(e), class: "btn" %>
      <% if e.clocking? %>
      <% elsif Setting.ink_signatures? %>
        <% unless e.recorded? %><%= button_to "Record", submit_work_entry_path(e), class: "btn-primary" %><% end %>
      <% elsif e.supervisor %>
        <%= button_to "Send to #{e.supervisor.name}", submit_work_entry_path(e), class: "btn-primary" %>
      <% end %>
      <%= button_to "Delete", work_entry_path(e), method: :delete, class: "btn-danger", form: { data: { turbo_confirm: "Delete this entry?" } } %>
    <% end %>
  </div>
</div>
<nav class="mb-4 flex items-center justify-between gap-2 text-sm" aria-label="Entries" data-controller="keynav">
  <% if @previous %>
    <%= link_to work_entry_path(@previous), class: "btn btn-sm", rel: "prev", title: "Earlier entry (← key)", data: { keynav_target: "previous" } do %>← Previous <span class="muted"><%= l(@previous.performed_on, format: :short) %></span><% end %>
  <% else %><span></span><% end %>
  <%= link_to "All entries", work_entries_path(technician_id: (e.user_id unless e.user == current_user)), class: "link" %>
  <% if @next %>
    <%= link_to work_entry_path(@next), class: "btn btn-sm", rel: "next", title: "Later entry (→ key)", data: { keynav_target: "next" } do %><span class="muted"><%= l(@next.performed_on, format: :short) %></span> Next →<% end %>
  <% else %><span></span><% end %>
</nav>
<%= render "clock_banner", entry: e if e.user == current_user %>
<% if e.returned? %><div class="mb-4 rounded-lg bg-red-50 px-4 py-3 text-sm text-red-800 dark:bg-red-900/40 dark:text-red-200"><strong>Returned:</strong> <%= e.returned_reason %></div><% end %>

<div class="grid gap-4 md:grid-cols-3">
  <div class="card md:col-span-2 space-y-4">
    <%= markdown(e.description) %>
    <dl class="grid grid-cols-2 gap-3 text-sm sm:grid-cols-3">
      <div><dt class="muted">Technician</dt><dd><%= e.user.name %></dd></div>
      <div><dt class="muted">Hours</dt><dd><%= e.clocking? ? "Clock running" : hours(e.hours) %></dd></div>
      <div><dt class="muted">Category</dt><dd><%= e.category_label %></dd></div>
      <div><dt class="muted">Aircraft</dt><dd><%= e.aircraft ? link_to(e.aircraft.to_s, e.aircraft, class: "link") : "—" %></dd></div>
      <div><dt class="muted">ATA</dt><dd><%= e.ata_label || "—" %></dd></div>
      <div><dt class="muted">Reference</dt><dd><%= e.reference.presence || "—" %></dd></div>
      <div><dt class="muted">Location</dt><dd><%= e.location.presence || "—" %></dd></div>
      <% if e.started_at %><div><dt class="muted">Clocked</dt><dd><%= l(e.started_at, format: :short) %> – <%= l(e.ended_at, format: :short) if e.ended_at %></dd></div><% end %>
    </dl>
    <% if e.subject_areas.any? %>
      <div><div class="mb-1 text-sm muted">ACS subject areas</div>
        <div class="flex flex-wrap gap-1"><% e.subject_area_labels.each do |l| %><span class="badge bg-slate-100 text-slate-700 dark:bg-slate-700 dark:text-slate-200"><%= l %></span><% end %></div></div>
    <% end %>
  </div>
  <div class="card">
    <h2 class="h2 mb-2">Signature</h2>
    <% if (s = e.signature) %>
      <p class="font-medium"><%= s.signer_name %></p>
      <p class="text-sm muted"><%= s.certificate_label %> · <%= l(s.signed_at, format: :long) %></p>
      <p class="mt-2 text-sm italic">“<%= s.statement %>”</p>
      <p class="mt-3 text-sm <%= s.intact? ? "text-emerald-700 dark:text-emerald-400" : "text-red-700 dark:text-red-400" %>">
        <%= s.intact? ? "✓ Verified: the entry and signature are unchanged since signing." : "⚠ This entry or its signature changed after signing." %>
      </p>
      <p class="mt-1 font-mono text-xs muted">ID <%= s.seal.first(8) %> · signed with <%= s.auth_method_label %></p>
    <% elsif Setting.ink_signatures? %>
      <p class="font-medium"><%= e.supervisor_display_name || "No supervisor entered" %></p>
      <p class="text-sm muted"><%= e.supervisor_display_certificate %></p>
      <p class="mt-2 text-sm"><%= e.recorded? ? "Recorded. Signed in ink on the printed logbook." : "Draft: record it when it's complete." %></p>
    <% elsif e.submitted? %>
      <p class="text-sm">Waiting for <strong><%= e.supervisor.name %></strong> to sign (sent <%= l(e.submitted_at, format: :short) %>).</p>
    <% else %>
      <p class="text-sm muted">Not signed yet.<%= " Supervisor: #{e.supervisor.name}." if e.supervisor %></p>
    <% end %>
  </div>
</div>

<% if e.imported? && (d = e.import_details) %>
  <div class="card mt-4 text-sm">
    <h2 class="h2 mb-2">Imported</h2>
    <p>From <%= d["source"] == "export" ? "an AMT Logbook export" : "a spreadsheet" %><%= " (#{d["file"]})" if d["file"].present? %><%= ", #{l(e.entry_import.imported_at, format: :short)}" if e.entry_import&.imported_at %>.</p>
    <% if d["aircraft"].present? %><p class="mt-1">Aircraft in the file: <strong><%= d["aircraft"] %></strong> (not a US N-number, so it isn't linked).</p><% end %>
    <% if Array(d["suggested"]).any? %>
      <p class="mt-1 text-amber-700 dark:text-amber-300">The file had no <%= d["suggested"].map { _1.humanize(capitalize: false).sub("ata", "ATA").sub("subject areas", "ACS subject areas") }.to_sentence %>; these were suggested from the description. Check them before recording.</p>
    <% end %>
    <% if (sig = d["signature"]) %>
      <p class="mt-1">Signed on the original server by <strong><%= sig["signer_name"] %></strong> (<%= Faa.certificate_short(sig["certificate_kind"]) %> <%= sig["certificate_number"] %>) on <%= sig["signed_at"].to_s.first(10) %><%= sig["intact"] == false ? ", and that signature had already been flagged as changed" : "" %>.</p>
      <p class="mt-1 muted">Electronic signatures can't move between servers (each server seals its own), so this is a draft here: send it for signature again, or keep the original export as the record of that signature.</p>
    <% elsif d["original_status"].present? && d["original_status"] != "draft" %>
      <p class="mt-1 muted">Status on the original server: <%= d["original_status"] %>.</p>
    <% end %>
  </div>
<% end %>
