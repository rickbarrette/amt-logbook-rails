<%= form_with model: entry, class: "space-y-5", data: { controller: "entry-suggest", entry_suggest_url_value: suggestions_entry_path } do |f| %>
  <% if entry.returned? && entry.returned_reason.present? %>
    <div class="rounded-lg bg-red-50 px-4 py-3 text-sm text-red-800 dark:bg-red-900/40 dark:text-red-200"><strong>Returned by <%= entry.supervisor&.name %>:</strong> <%= entry.returned_reason %></div>
  <% end %>
  <% if entry.errors.any? %>
    <div class="rounded-lg bg-red-50 px-4 py-3 text-sm text-red-800 dark:bg-red-900/40 dark:text-red-200"><%= entry.errors.full_messages.to_sentence %></div>
  <% end %>

  <div class="grid gap-4 sm:grid-cols-3">
    <div><%= f.label :performed_on, "Date", class: "label" %><%= f.date_field :performed_on, required: true, max: Date.current, class: "input" %></div>
    <% if entry.clocking? %>
      <div><span class="label">Hours</span><p class="input bg-slate-50 text-slate-500 dark:bg-slate-800">Set at clock-out</p></div>
    <% else %>
      <div><%= f.label :hours, class: "label" %><%= f.number_field :hours, value: (entry.minutes ? entry.hours : nil), step: 0.1, min: 0.1, max: 24, required: true, inputmode: "decimal", class: "input" %></div>
    <% end %>
    <div class="relative" data-controller="aircraft-lookup suggest" data-aircraft-lookup-url-value="<%= lookup_aircraft_index_path %>" data-suggest-url-value="<%= suggestions_aircraft_path %>">
      <%= f.label :n_number, "Aircraft N-number", class: "label" %>
      <%= f.text_field :n_number, placeholder: "N12345 (optional)", autocapitalize: "characters", class: "input uppercase",
            data: { aircraft_lookup_target: "input", suggest_target: "input",
                    action: "input->aircraft-lookup#lookup input->suggest#search focus->suggest#focus keydown->suggest#keydown blur->suggest#blur" } %>
      <ul data-suggest-target="list" hidden class="absolute z-30 mt-1 max-h-72 w-full overflow-auto rounded-lg border border-slate-200 bg-white shadow-lg dark:border-slate-600 dark:bg-slate-800"></ul>
      <p data-aircraft-lookup-target="result" class="hint"><%= entry.aircraft&.description %></p>
    </div>
  </div>

  <div data-controller="markdown-editor" data-markdown-editor-url-value="<%= markdown_preview_path %>">
    <div class="mb-1 flex flex-wrap items-end justify-between gap-2">
      <%= f.label :description, "Description of work performed", class: "label mb-0" %>
      <div class="flex text-xs" role="tablist">
        <button type="button" role="tab" class="border-b-2 px-2 py-1" data-markdown-editor-target="writeTab" data-action="markdown-editor#write">Write</button>
        <button type="button" role="tab" class="border-b-2 px-2 py-1" data-markdown-editor-target="previewTab" data-action="markdown-editor#preview">Preview</button>
      </div>
    </div>
    <div class="overflow-hidden rounded-lg border border-slate-300 focus-within:border-sky-600 focus-within:ring-1 focus-within:ring-sky-600 dark:border-slate-600">
      <div class="flex flex-wrap gap-0.5 border-b border-slate-200 bg-slate-50 px-1 py-1 dark:border-slate-700 dark:bg-slate-800" data-markdown-editor-target="toolbar" role="toolbar" aria-label="Formatting">
        <% [["bold", "B", "Bold (Ctrl+B)", "font-bold"], ["italic", "I", "Italic (Ctrl+I)", "italic"], ["heading", "H", "Heading", "font-semibold"],
            ["bullets", "• List", "Bulleted list", ""], ["numbers", "1. List", "Numbered list", ""], ["code", "</>", "Part or reference number", "font-mono"],
            ["link", "Link", "Link", "underline"]].each do |action, text, title, style| %>
          <button type="button" class="rounded px-2 py-1 text-xs text-slate-700 hover:bg-slate-200 dark:text-slate-200 dark:hover:bg-slate-700 <%= style %>" title="<%= title %>" aria-label="<%= title %>" data-action="markdown-editor#<%= action %>"><%= text %></button>
        <% end %>
      </div>
      <%= f.text_area :description, rows: 6, required: true, class: "block w-full border-0 bg-white px-3 py-2 text-slate-900 focus:outline-none dark:bg-slate-900 dark:text-slate-100",
            placeholder: "- Removed and replaced left main brake assembly per Cessna 172 MM 32-40-00\n- Torqued, safetied, ops checked",
            data: { markdown_editor_target: "input", entry_suggest_target: "description", action: "keydown->markdown-editor#keydown input->entry-suggest#changed" } %>
      <div data-markdown-editor-target="output" hidden class="min-h-36 bg-white px-3 py-2 dark:bg-slate-900"></div>
    </div>
    <p class="hint">Be specific: what you did, on what, and the reference used (manual, AC 43.13-1B…). Markdown works: <code>- list</code>, <code>**bold**</code>.</p>
    <div data-entry-suggest-target="chip" hidden class="mt-2 flex flex-wrap items-center gap-2 rounded-lg bg-sky-50 px-3 py-2 text-sm text-sky-900 dark:bg-sky-950 dark:text-sky-100">
      <span>Suggested: <strong data-entry-suggest-target="text"></strong></span>
      <button type="button" class="btn-primary btn-sm" data-action="entry-suggest#apply">Use</button>
      <button type="button" class="btn btn-sm" data-action="entry-suggest#dismiss">Dismiss</button>
      <p data-entry-suggest-target="also" hidden class="w-full text-xs text-sky-800 dark:text-sky-200"></p>
    </div>
  </div>

  <fieldset>
    <legend class="label">Category</legend>
    <div class="flex flex-wrap gap-2">
      <% Faa.categories.each do |key, label| %>
        <label class="flex cursor-pointer items-center gap-2 rounded-lg border border-slate-300 px-3 py-2 text-sm has-[:checked]:border-sky-600 has-[:checked]:bg-sky-50 dark:border-slate-600 dark:has-[:checked]:bg-sky-950">
          <%= f.radio_button :category, key, class: "accent-sky-700" %> <%= label %>
        </label>
      <% end %>
    </div>
    <p class="hint">General work counts toward either rating.</p>
  </fieldset>

  <div class="grid gap-4 sm:grid-cols-3">
    <div><%= f.label :ata_chapter, "ATA chapter", class: "label" %><%= f.select :ata_chapter, ata_options, { include_blank: "—" }, class: "input" %></div>
    <div><%= f.label :reference, "Work order / task card", class: "label" %><%= f.text_field :reference, class: "input" %></div>
    <div class="relative" data-controller="suggest" data-suggest-url-value="<%= suggestions_locations_path %>">
      <%= f.label :location, class: "label" %>
      <%= f.text_field :location, class: "input", placeholder: "Airport code or shop",
            data: { suggest_target: "input", action: "input->suggest#search focus->suggest#focus keydown->suggest#keydown blur->suggest#blur" } %>
      <ul data-suggest-target="list" hidden class="absolute z-30 mt-1 max-h-72 w-full min-w-72 overflow-auto rounded-lg border border-slate-200 bg-white shadow-lg dark:border-slate-600 dark:bg-slate-800"></ul>
    </div>
  </div>

  <details data-acs class="rounded-lg border border-slate-200 p-3 dark:border-slate-700" <%= "open" if entry.subject_areas.any? %>>
    <summary class="cursor-pointer text-sm font-medium">ACS subject areas <span class="muted" data-acs-count>(<%= entry.subject_areas.size %> selected)</span></summary>
    <p class="hint mb-2">The FAA wants your experience to cover the subject areas of the Airman Certification Standards for the ratings you're seeking.</p>
    <% Faa.acs_sections.each do |key, section| %>
      <div class="mt-3">
        <div class="mb-1 text-xs font-semibold uppercase tracking-wide muted"><%= section["label"] %></div>
        <div class="grid gap-1 sm:grid-cols-2 lg:grid-cols-3">
          <% section["areas"].each do |code, label| %>
            <label class="flex items-start gap-2 text-sm"><%= check_box_tag "work_entry[subject_areas][]", code, entry.subject_areas.include?(code), id: "sa_#{code}", class: "mt-1 accent-sky-700" %> <span><%= label %></span></label>
          <% end %>
        </div>
      </div>
    <% end %>
    <%= hidden_field_tag "work_entry[subject_areas][]", "" %>
  </details>

  <% if Setting.ink_signatures? %>
    <div class="grid gap-4 sm:grid-cols-2">
      <div><%= f.label :supervisor_name, "Supervisor", class: "label" %><%= f.text_field :supervisor_name, class: "input", list: "supervisor-names", placeholder: "Who supervised this work" %></div>
      <div><%= f.label :supervisor_certificate, "Supervisor's certificate", class: "label" %><%= f.text_field :supervisor_certificate, class: "input", placeholder: "e.g. A&P 1234567" %></div>
      <datalist id="supervisor-names"><% current_user.work_entries.where.not(supervisor_name: nil).distinct.pluck(:supervisor_name).each do |n| %><option value="<%= n %>"><% end %></datalist>
      <p class="hint sm:col-span-2">Your supervisor signs this entry by hand on the printed logbook.</p>
    </div>
  <% else %>
    <div>
      <%= f.label :supervisor_id, "Supervisor who will sign", class: "label" %>
      <% if current_user.supervisors.any? %>
        <%= f.select :supervisor_id, current_user.supervisors.ordered.map { |s| [s.name, s.id] }, { include_blank: "—" }, class: "input sm:w-80" %>
      <% else %>
        <p class="text-sm text-amber-700 dark:text-amber-300">No supervisors are linked to your account yet. Ask your administrator to add one; you can save drafts meanwhile.</p>
      <% end %>
    </div>
  <% end %>

  <% primary = if Setting.ink_signatures? then "Save and record"
               elsif current_user.supervisors.any? then "Save and send for signature"
               end %>
  <div class="flex flex-wrap gap-2">
    <% if entry.clocking? %>
      <%= f.submit "Save", class: "btn-primary" %>
    <% else %>
    <%= f.submit "Save draft", class: "btn" %>
    <% if primary %><%= f.submit primary, name: "submit_for_signature", class: "btn-primary" %><% end %>
    <% if entry.new_record? %>
      <%= f.button "#{primary || "Save draft"} and add another", type: "submit", name: "add_another", value: "1", class: "btn" %>
    <% end %>
    <% end %>
  </div>
<% end %>
