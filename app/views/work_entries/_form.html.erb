<%= form_with model: entry, class: "space-y-5" do |f| %>
  <% if entry.returned? && entry.returned_reason.present? %>
    <div class="rounded-lg bg-red-50 px-4 py-3 text-sm text-red-800 dark:bg-red-900/40 dark:text-red-200"><strong>Returned by <%= entry.supervisor&.name %>:</strong> <%= entry.returned_reason %></div>
  <% end %>
  <% if entry.errors.any? %>
    <div class="rounded-lg bg-red-50 px-4 py-3 text-sm text-red-800 dark:bg-red-900/40 dark:text-red-200"><%= entry.errors.full_messages.to_sentence %></div>
  <% end %>

  <div class="grid gap-4 sm:grid-cols-3">
    <div><%= f.label :performed_on, "Date", class: "label" %><%= f.date_field :performed_on, required: true, max: Date.current, class: "input" %></div>
    <div><%= f.label :hours, class: "label" %><%= f.number_field :hours, value: (entry.minutes ? entry.hours : nil), step: 0.1, min: 0.1, max: 24, required: true, inputmode: "decimal", class: "input" %></div>
    <div data-controller="aircraft-lookup" data-aircraft-lookup-url-value="<%= lookup_aircraft_index_path %>">
      <%= f.label :n_number, "Aircraft N-number", class: "label" %>
      <%= f.text_field :n_number, placeholder: "N12345 (optional)", autocapitalize: "characters", class: "input uppercase", data: { aircraft_lookup_target: "input", action: "input->aircraft-lookup#lookup" } %>
      <p data-aircraft-lookup-target="result" class="hint"><%= entry.aircraft&.description %></p>
    </div>
  </div>

  <fieldset>
    <legend class="label">Category</legend>
    <div class="flex flex-wrap gap-2">
      <% Faa.categories.each do |key, label| %>
        <label class="flex cursor-pointer items-center gap-2 rounded-lg border border-slate-300 px-3 py-2 text-sm has-[:checked]:border-sky-600 has-[:checked]:bg-sky-50 dark:border-slate-600 dark:has-[:checked]:bg-sky-950">
          <%= f.radio_button :category, key, class: "accent-sky-700" %> <%= label %>
        </label>
      <% end %>
    </div>
    <p class="hint">General work counts toward either rating.</p>
  </fieldset>

  <div><%= f.label :description, "Description of work performed", class: "label" %>
    <%= f.text_area :description, rows: 4, required: true, class: "input", placeholder: "e.g. Removed and replaced left main brake assembly per Cessna 172 MM 32-40-00; torqued, safetied, ops checked." %>
    <p class="hint">Be specific: what you did, on what, and the reference used (manual, AC 43.13-1B…).</p></div>

  <div class="grid gap-4 sm:grid-cols-3">
    <div><%= f.label :ata_chapter, "ATA chapter", class: "label" %><%= f.select :ata_chapter, ata_options, { include_blank: "—" }, class: "input" %></div>
    <div><%= f.label :reference, "Work order / task card", class: "label" %><%= f.text_field :reference, class: "input" %></div>
    <div><%= f.label :location, class: "label" %><%= f.text_field :location, class: "input", placeholder: "Shop or airport" %></div>
  </div>

  <details class="rounded-lg border border-slate-200 p-3 dark:border-slate-700" <%= "open" if entry.subject_areas.any? %>>
    <summary class="cursor-pointer text-sm font-medium">ACS subject areas <span class="muted">(<%= entry.subject_areas.size %> selected)</span></summary>
    <p class="hint mb-2">The FAA wants your experience to cover the subject areas of the Airman Certification Standards for the ratings you're seeking.</p>
    <% Faa.acs_sections.each do |key, section| %>
      <div class="mt-3">
        <div class="mb-1 text-xs font-semibold uppercase tracking-wide muted"><%= section["label"] %></div>
        <div class="grid gap-1 sm:grid-cols-2 lg:grid-cols-3">
          <% section["areas"].each do |code, label| %>
            <label class="flex items-start gap-2 text-sm"><%= check_box_tag "work_entry[subject_areas][]", code, entry.subject_areas.include?(code), id: "sa_#{code}", class: "mt-1 accent-sky-700" %> <span><%= label %></span></label>
          <% end %>
        </div>
      </div>
    <% end %>
    <%= hidden_field_tag "work_entry[subject_areas][]", "" %>
  </details>

  <div>
    <%= f.label :supervisor_id, "Supervisor who will sign", class: "label" %>
    <% if current_user.supervisors.any? %>
      <%= f.select :supervisor_id, current_user.supervisors.ordered.map { |s| [s.name, s.id] }, { include_blank: "—" }, class: "input sm:w-80" %>
    <% else %>
      <p class="text-sm text-amber-700 dark:text-amber-300">No supervisors are linked to your account yet. Ask your administrator to add one; you can save drafts meanwhile.</p>
    <% end %>
  </div>

  <div class="flex flex-wrap gap-2">
    <%= f.submit "Save draft", class: "btn" %>
    <% if current_user.supervisors.any? %><%= f.submit "Save and send for signature", name: "submit_for_signature", class: "btn-primary" %><% end %>
  </div>
<% end %>
