<% content_for :title, "About" %>
<% info = @info %>
<h1 class="h1 mb-1">About</h1>
<p class="mb-5 text-sm muted">AMT Logbook: practical-experience records for the FAA mechanic certificate (14 CFR 65.77). Open source, public domain.</p>

<section class="card mb-5">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <p class="text-xs uppercase tracking-wide muted">Version</p>
      <p class="font-mono text-2xl font-semibold"><%= info.version %></p>
      <p class="text-sm muted">Build <%= info.revision_url ? link_to(info.revision, info.revision_url, class: "link font-mono", target: "_blank", rel: "noopener") : tag.span(info.revision, class: "font-mono") %></p>
      <p class="mt-1 flex flex-wrap gap-x-3 text-sm">
        <%= link_to "Release notes", "#releases", class: "link" %>
        <% if info.repository_url %><%= link_to "Source code", info.repository_url, class: "link", target: "_blank", rel: "noopener" %><% end %>
      </p>
    </div>
    <dl class="grid grid-cols-2 gap-x-6 gap-y-1 text-sm sm:grid-cols-3">
      <div><dt class="muted">Built</dt><dd class="font-medium"><%= info.built_at ? l(info.built_at.in_time_zone, format: :short) : "—" %></dd></div>
      <div><dt class="muted">Started</dt><dd class="font-medium"><%= l(info.booted_at.in_time_zone, format: :short) %></dd></div>
      <div><dt class="muted">Uptime</dt><dd class="font-medium"><%= distance_of_time_in_words(info.booted_at, Time.current) %></dd></div>
    </dl>
  </div>
</section>

<section class="card mb-5" id="releases">
  <h2 class="h2 mb-2">What's new</h2>
  <% if @changelog.releases.empty? %>
    <p class="text-sm muted">No release notes.</p>
  <% else %>
    <div class="divide-y divide-slate-100 dark:divide-slate-700">
      <% @changelog.releases.each_with_index do |r, i| %>
        <details id="<%= r.anchor %>" class="py-2" <%= "open" if r.version == info.version || (i.zero? && !@changelog.release(info.version)) %>>
          <summary class="cursor-pointer font-medium"><%= r.version %><%= tag.span(" · running", class: "badge ml-2 bg-emerald-100 text-emerald-800 dark:bg-emerald-900/50 dark:text-emerald-200") if r.version == info.version %></summary>
          <%= markdown(r.markdown, class: "mt-2") %>
        </details>
      <% end %>
    </div>
  <% end %>
</section>

<% if current_user.admin? %>
  <div class="grid gap-5 lg:grid-cols-2">
    <section class="card"><h2 class="h2 mb-1">Configuration</h2><%= render "pairs", pairs: info.features %></section>
    <section class="card"><h2 class="h2 mb-1">Runtime</h2><%= render "pairs", pairs: info.runtime %></section>
    <section class="card"><h2 class="h2 mb-1">Records</h2><%= render "pairs", pairs: info.record_counts.transform_values { number_with_delimiter(_1) } %></section>
    <div class="space-y-5">
      <section class="card">
        <h2 class="h2 mb-1">Storage</h2>
        <%= render "pairs", pairs: info.databases.map { |label, bytes| [ "#{label} database", bytes && number_to_human_size(bytes) ] } +
              [ [ "Free disk space", (b = info.free_disk_bytes) && number_to_human_size(b) ] ] %>
      </section>
      <section class="card">
        <h2 class="h2 mb-1">Background jobs</h2>
        <% if (j = info.jobs) %>
          <%= render "pairs", pairs: [ [ "Workers running", j[:workers].zero? ? tag.span("none", class: "badge bg-red-100 text-red-800") : j[:workers] ],
                [ "Waiting", j[:ready] ], [ "Scheduled", j[:scheduled] ],
                [ "Failed", j[:failed].positive? ? tag.span(j[:failed], class: "badge bg-amber-100 text-amber-800") : 0 ] ] %>
        <% else %>
          <p class="text-sm muted">The job queue isn't available.</p>
        <% end %>
      </section>
      <section class="card"><h2 class="h2 mb-1">Key components</h2><%= render "pairs", pairs: info.key_gems %></section>
    </div>
  </div>
  <details class="card mt-5">
    <summary class="cursor-pointer font-semibold">All gems (<%= info.all_gems.size %>)</summary>
    <div class="mt-2 grid gap-x-6 font-mono text-xs sm:grid-cols-2 lg:grid-cols-3">
      <% info.all_gems.each do |name, version| %><div class="flex justify-between gap-2 py-0.5"><span class="truncate"><%= name %></span><span class="muted"><%= version %></span></div><% end %>
    </div>
  </details>
<% end %>
